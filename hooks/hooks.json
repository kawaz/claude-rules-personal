{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'メインコンテキストは統括指揮となることが役割です。実作業に取り掛かる前に rules-personal:load-role-main スキルを実行してください。' #rules-personal-role-loader"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/vcs-skill-autoload.sh\""
          }
        ]
      }
    ]
  }
}
