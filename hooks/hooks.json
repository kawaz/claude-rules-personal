{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'メインコンテキストは統括指揮となることが役割です。実作業に取り掛かる前に rules-personal:load-role-main スキルを実行してください。' #rules-personal-role-loader"
          }
        ]
      },
      {
        "matcher": "resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'resume/clear 直後は応答言語が英語に流れることがあります。日本語で応答する設定を再確認してください。' #rules-personal-language-reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/vcs-skill-autoload.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-mass-kill.sh\" #rules-personal-guard-mass-kill",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-create-path.sh\" #rules-personal-worktree-path"
          }
        ]
      }
    ]
  }
}
